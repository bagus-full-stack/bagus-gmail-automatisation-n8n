    {
      "parameters": {
        "jsCode": "// Why Code: tri, nettoyage anti-injection et mise en tableau compact de toutes les lignes.\nconst q = String($('Appel depuis un workflow').first().json.text || '').slice(0, 500);\nconst rows = $input.all().map(function (i) { return i.json; }).filter(function (r) { return r.Statut; });\nrows.sort(function (a, b) { return String(b.Date).localeCompare(String(a.Date)); });\nfunction clean(v) { return String(v == null ? '' : v).replace(/[\\r\\n|<>]+/g, ' ').slice(0, 60); }\nconst table = rows.slice(0, 200).map(function (r) {\n  return [clean(r.Entreprise), clean(r.Poste), r.Statut, String(r.Date).slice(0, 10), clean(r.Action), r['Priorité'], clean(r['Contact RH']), clean(r['Prochaine étape'])].join(' | ');\n}).join('\\n');\nreturn [{ json: { question: q, today: DateTime.now().toFormat('yyyy-MM-dd (cccc)'), table: table || '(aucune candidature)' } }];"
      },
      "id": "e7095460-56e3-4414-8224-c1ddc3b45265",
      "name": "Build Context",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        96
      ]
    },
    {
      "parameters": {
        "jsCode": "// Why Code: validation stricte de la sortie Gemini et comptage déterministe des refus à archiver.\nconst raw = $input.first().json;\nconst txt = raw.output || raw.text || (raw.content && raw.content.parts && raw.content.parts[0] && raw.content.parts[0].text) || '';\nlet p = {};\ntry { p = typeof txt === 'object' ? txt : JSON.parse(String(txt).replace(/```json|```/g, '').trim()); } catch (e) { p = {}; }\nlet message = String(p.reponse || '').slice(0, 3500) || \"Je n'ai pas compris, reformule ta question.\";\nlet date = null;\nlet count = 0;\nif (p.intent === 'ARCHIVE_REFUS' && /^\\d{4}-\\d{2}-\\d{2}$/.test(String(p.date))) {\n  date = p.date;\n  count = $('Get Candidatures').all().filter(function (i) {\n    return i.json.Statut === 'REFUS' && i.json.Action !== 'ARCHIVÉ' && String(i.json.Date).startsWith(date);\n  }).length;\n  message = count > 0\n    ? 'Archiver ' + count + ' refus du ' + date + \" ? Les mails quittent la boîte de réception, rien n'est supprimé.\" + (count > 50 ? ' (50 maximum par lancement.)' : '')\n    : 'Aucun refus non archivé trouvé le ' + date + '.';\n}\n// shortcut: le nœud Telegram parse en Markdown legacy, \"EN_ATTENTE\" casse l'envoi sans échappement\nmessage = message.replace(/([_*`\\[])/g, '\\\\$1');\nreturn [{ json: { message: message, date: date, count: count } }];"
      },
      "id": "79defe48-a1c7-4ede-91d8-7dff77ac7835",
      "name": "Parse Reply",
