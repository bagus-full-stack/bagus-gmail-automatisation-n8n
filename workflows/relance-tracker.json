                "operation": "equals"
              }
            },
            {
              "id": "ent",
              "leftValue": "={{ $json.Entreprise }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            },
            {
              "id": "age",
              "leftValue": "={{ DateTime.fromISO($json.Date).isValid && DateTime.fromISO($json.Date) < $now.minus({ days: 7 }) }}",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            },
            {
              "id": "closed",
              "leftValue": "={{ !$('Get Candidatures').all().some(i => i.json.Entreprise === $json.Entreprise && ['REFUS','POSITIF'].includes(i.json.Statut) && (!i.json.Poste || !$json.Poste || i.json.Poste === $json.Poste) && DateTime.fromISO(i.json.Date) >= DateTime.fromISO($json.Date)) }}",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ]
        },
        "looseTypeValidation": true,
        "options": {}
